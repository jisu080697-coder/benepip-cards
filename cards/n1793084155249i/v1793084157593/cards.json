{"id":"n1793084155249i","ver":"v1793084157593","group":"경제·투자 이슈","cards":[{"fig":"경제·투자 1","v":{"t3":"월요일 아침\n“가격 급등”\n왜 그럴까?","t4":"주말 갭 현상, 미리 알고 대비해요","th":"orange:rocket"}},{"fig":"경제·투자 2","v":{"t2":"월요일 개장 직후 “확” 벌어지는 가격","t3":"주말 갭이\n“무엇일까?”","t4":"주말 갭이란?","t5":"금요일 마감과 월요일 시작 가격\n사이의 큰 차이를 말해요.","t6":"주말 동안 시장이 닫혀 있을 때 발표된 뉴스가\n월요일 개장과 함께 가격에 반영돼요.","t7":"“월요일 아침” 특히 주의하세요.","th":"orange:clock"}},{"fig":"경제·투자 3","v":{"t10":"유동성 부족 현상","t11":"새로운 한 주 시작,\n“시장 흐름”을 살펴요","t2":"주말 갭\n“주요 원인”","t4":"주요 경제 지표 발표","t6":"지정학적 사건 발생","t8":"예상치 못한 사건","th":"orange:none"}},{"fig":"경제·투자 4","v":{"t2":"주말 갭,\n“궁금해요!”","t3":"주말 갭 현상은\n“신중한 접근”이 중요해요.","t4":"주말 갭은 항상 메워지나요?","t5":"예측하기 어려워요.","t6":"갭 이용 전략은?","t7":"위험할 수 있으니 신중하게\n접근하는 것이 중요해요.","th":"orange:none"}},{"fig":"경제·투자 5","v":{"t10":"갭 직후 시장 거래량 주시.","t11":"* 모든 전략은 개인의 투자 성향에 따라 달라질 수 있습니다.","t2":"주말 갭 “대비 전략”","t3":"포지션","t4":"불확실성 크면 정리 좋아요.","t5":"리스크","t6":"소액으로 거래하며 관리하세요.","t7":"금","t8":"주말 뉴스를 꼭 확인해 보세요.","t9":"거래량","th":"orange:none"}},{"fig":"경제·투자 6","v":{"t2":"“BenePip”과 함께 준비하세요!","th":"orange:money-bag"}}]}